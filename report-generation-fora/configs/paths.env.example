# Copy to configs/paths.env and edit. scripts/dfw/run_stage.sbatch sources it.
export BUNDLE=/path/to/mrdino3d_hplus_atlas_mil_epoch004       # MIL bundle (backbone_release/, checkpoint/, code/, dfw_mil/)
export DINOV3_ROOT=/path/to/dinov3                             # DINOv3 at 6876159a11b4df116f30f667f8c9888617df0751
export FORA=/path/to/FORA                                      # github.com/forithmus/FORA checkout (fora + report-generation)
export DATA=/path/to/MR-RATE/mri_atlas                         # batchXX/<uid>/atlas_img/*.nii.gz
export SPLITS=/path/to/splits.csv                              # batch_id, patient_uid, study_uid, split
export LABELS=/path/to/mrrate_neurovfm74_labels.csv            # study_uid + the 74 diagnosis columns
export REPORTS="/path/to/reports/*.csv"                        # study_uid, findings (glob allowed)
export LLM=/path/to/gemma-4-31B-it                             # local snapshot of google/gemma-4-31B-it
export OUT=/path/to/runs/mrrate_writer                         # all outputs of the pipeline
export VLLM_PYTHON=                                            # python with vLLM, for STAGE=tag
